# Copy this file to .env and fill in your local Postgres credentials
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/restaurant_inventory

# Auth - generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
